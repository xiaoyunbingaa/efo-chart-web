{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "ignoreDeprecations": "6.0",
        "strict": true,
        "noEmit": true,
        "types": [
            "node",
            "element-plus/global"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "postcss.config.ts"
    ]
}